# Number check karo — pass ya fail?
number = adad(lo "Apne number likho (0-100): ")

agar number >= 50 to
    likho "Mubarak! Aap PASS ho gaye 🎉"
    agar number >= 90 to
        likho "Grade: A+ 🌟"
    warna
        likho "Mehnat jari rakho, agli baar A+!"
    bas
warna
    likho "Afsos, FAIL. Himmat na haro, dobara try karo! 💪"
bas
