# Ghalti se program na ruke — pakro!

koshish
    likho 10 / 0
pakro masla
    likho "Pata chal gaya: " + masla
bas

koshish
    likho "Yeh theek hai"
pakro masla
    likho "Yahan nahi aana chahiye"
bas

kaam salaam(naam = "Mehman")
    likho "Assalam-o-Alaikum, " + naam + "!"
bas

salaam()
salaam("Fatima")

lao "lib_hisab.asaan"
likho "9 ka darja: " + darja(9)
