# Kitab (dictionary) — key : value
talib = {naam: "Ali", umar: 14, shehar: "Kasur"}

likho "Naam: " + talib["naam"]
likho "Umar: " + talib["umar"]

talib["grade"] = "A"
likho "Kul kunjiyan: " + lambai(talib)

har k andar talib to
    likho k + " = " + talib[k]
bas

likho "qisam: " + qisam(talib)
likho "naam andar kitab? " + ("naam" andar talib)
