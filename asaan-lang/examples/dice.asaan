# ittifaq = random, dohrao = n dafa repeat, += jama

likho "5 dafa dice:"
dohrao 5 to
    likhsath "  🎲 "
    likho ittifaq(1, 6)
bas

n = 0
dohrao 4 to
    n += 10
bas
likho "n += 10 char dafa: " + n

likho "2 ki 8 quwwat: " + (2 ** 8)
likho "jazar 81: " + jazar(81)
likho "kam 3, 9, 1: " + kam(3, 9, 1)
likho "hissa Pakistan 1-3: " + hissa("Pakistan", 1, 3)
