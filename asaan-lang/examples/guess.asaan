# Number guess — ittifaq + agar + koshish
raaz = ittifaq(1, 5)
likho "1 se 5 tak ek number socho."

koshish
    andaza = adad(lo "Aapka andaza: ")
    agar andaza == raaz to
        likho "Sahi! Yehi tha " + raaz + " 🎉"
    aur agar andaza > raaz to
        likho "Bohat bara. Asal: " + raaz
    warna
        likho "Bohat chhota. Asal: " + raaz
    bas
pakro g
    likho "Number likhna tha. " + g
bas
