# aur agar (else-if) — aik hi block mein kai shartein
number = adad(lo "Apne number likho (0-100): ")

agar number >= 90 to
    likho "Grade: A+ 🌟  Shahkar!"
aur agar number >= 80 to
    likho "Grade: A  Mubarak, bohat acha."
aur agar number >= 70 to
    likho "Grade: B  Achi mehnat."
aur agar number >= 50 to
    likho "Grade: C  Pass — ab A ke liye push karo."
warna
    likho "Fail. Himmat na haro, kal naya din hai 💪"
bas
